# Music Matters — backend environment overrides
# Copy to .env (same folder) and set only what you want to change.
# Variable names match backend/app/config.py exactly (case-sensitive).

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8010
# DEBUG=false
# RELOAD=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Root of your audio library. The app stores/reads:
#   $MUSIC_LIBRARY/downloads  $MUSIC_LIBRARY/stems  $MUSIC_LIBRARY/loops
#   $MUSIC_LIBRARY/projects   $MUSIC_LIBRARY/library.db
# Default: ~/music-matters
# MUSIC_LIBRARY=/Volumes/deep-1t/Users/k3ss/music-matters
# CACHE_DIR=~/.cache/music-matters
# TEMP_DIR=~/.cache/music-matters/temp

# HuggingFace / model cache — keep large model weights off the boot drive.
# HF_HOME=/Volumes/MLX/cache

# ── Stem separation (Demucs) ──────────────────────────────────────────────────
# DEMUCS_MODEL=htdemucs_6s        # htdemucs | htdemucs_ft | htdemucs_6s
# DEMUCS_DEVICE=mps               # mps (Apple Silicon) | cuda | cpu
# DEMUCS_SHIFTS=1                 # 1=fast, 2+=higher quality

# ── Optional API keys ─────────────────────────────────────────────────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# DISCOGS_TOKEN=
# ACOUSTID_API_KEY=               # needs `brew install chromaprint` (fpcalc)
